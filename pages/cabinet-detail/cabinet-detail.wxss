.cabinet-overview { padding: 30rpx; }.title-row { display: flex; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 1rpx solid #f2e7e7; }.cabinet-id { display: block; font-size: 38rpx; font-weight: 800; }.cabinet-name { display: block; margin-top: 6rpx; color: #806d6e; font-size: 24rpx; }.cabinet-status { align-self: flex-start; padding: 8rpx 16rpx; border-radius: 24rpx; background: #e9f7f0; color: #25845b; font-size: 21rpx; }.cabinet-status.MAINTENANCE { background: #fff1dc; color: #b66d16; }.cabinet-status.DISABLED { background: #f1eeee; color: #806d6e; }.info { display: flex; justify-content: space-between; margin-top: 20rpx; color: #806d6e; font-size: 24rpx; }.info text:last-child { max-width: 420rpx; color: #352526; text-align: right; }.scene-card { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 25rpx; }.scene-card view text:first-child { display: block; font-size: 25rpx; font-weight: 700; }.scene-card view text:last-child { display: block; margin-top: 6rpx; color: #806d6e; font-size: 22rpx; }.scene-card .scene-content { flex: 1; min-width: 0; margin-right: 24rpx; }.scene-card .scene-content text:last-child { word-break: break-all; }.scene-card button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: auto; min-width: 164rpx; height: 64rpx; margin: 0; padding: 0 24rpx; box-sizing: border-box; background: #fae8e9; color: #c03338; font-size: 23rpx; font-weight: 600; line-height: 1; white-space: nowrap; }.waiting-alert { margin-top: 22rpx; padding: 22rpx; border-radius: 16rpx; background: #fff1dc; color: #8a5717; font-size: 23rpx; line-height: 1.6; }.waiting-alert text { display: block; margin-top: 8rpx; color: #c03338; font-weight: 700; }.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin: 24rpx 0 30rpx; }.action-grid button { width: 100%; background: #fae8e9; color: #c03338; font-size: 23rpx; }.action-grid .restore { background: #e9f7f0; color: #25845b; }.section-head { display: flex; justify-content: space-between; margin: 0 3rpx 16rpx; font-size: 29rpx; font-weight: 750; }.section-head text:last-child { color: #806d6e; font-size: 22rpx; font-weight: 400; }.locker-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }.locker { padding: 18rpx 5rpx; border-radius: 15rpx; background: #fff; text-align: center; }.locker text:first-child { display: block; font-size: 28rpx; font-weight: 800; }.locker text:last-child { display: block; margin-top: 5rpx; color: #25845b; font-size: 19rpx; }.locker.OCCUPIED text:last-child { color: #b66d16; }.locker.MAINTENANCE text:last-child { color: #c03338; }.disable-button { margin-top: 35rpx; background: #fff; color: #c03338; border: 2rpx solid #c03338; font-size: 25rpx; }.disabled-tip { display: block; margin-top: 35rpx; color: #806d6e; text-align: center; font-size: 23rpx; }
.locker-list { display: flex; flex-direction: column; gap: 14rpx; }
.locker-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx; }
.locker-number { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 15rpx; background: #fae8e9; color: #c03338; font-size: 28rpx; font-weight: 800; }
.locker-state { width: 115rpx; }.locker-state text:first-child { display: block; font-size: 24rpx; font-weight: 700; }.locker-state text:last-child { display: block; margin-top: 5rpx; color: #806d6e; font-size: 19rpx; }
.locker-row.OCCUPIED .locker-state text:first-child { color: #b66d16; }.locker-row.MAINTENANCE .locker-state text:first-child { color: #c03338; }.locker-row.DISABLED { opacity: .72; }
.locker-actions { display: flex; flex: 1; align-items: center; justify-content: flex-end; gap: 8rpx; }.locker-actions button { width: auto; min-width: 118rpx; margin: 0; padding: 0 12rpx; background: #fae8e9; color: #c03338; font-size: 20rpx; }.locker-actions .restore-locker { background: #e9f7f0; color: #25845b; }.locker-actions .disable-locker { background: #f1eeee; color: #806d6e; }.locker-actions text { color: #806d6e; font-size: 20rpx; }
.locker-actions .manual-unlock { background: #c03338; color: #fff; }
.locker-actions .inspect-empty { background: #fff1dc; color: #9a6218; }
.cabinet-fault-alert, .cabinet-health-passed { margin-top: 22rpx; padding: 20rpx; border-radius: 15rpx; font-size: 22rpx; line-height: 1.6; }.cabinet-fault-alert { background: #fae8e9; color: #c03338; }.cabinet-health-passed { background: #e9f7f0; color: #25845b; }
.work-order-entry { margin-top: 16rpx; background: #c03338; color: #fff; font-size: 23rpx; }
.consistency-alert { margin-top: 22rpx; padding: 24rpx; border: 2rpx solid #efc46f; background: #fff8e9; }.consistency-title text:first-child { display: block; color: #9a6218; font-size: 25rpx; font-weight: 750; }.consistency-title text:last-child { display: block; margin-top: 6rpx; color: #9b825e; font-size: 20rpx; }.consistency-item { display: flex; gap: 16rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f1dfba; font-size: 22rpx; }.consistency-item text:first-child { flex: none; color: #c03338; font-weight: 700; }.consistency-item text:last-child { color: #72552b; }.consistency-ok { margin-top: 22rpx; padding: 18rpx 22rpx; border-radius: 15rpx; background: #e9f7f0; color: #25845b; font-size: 22rpx; }
