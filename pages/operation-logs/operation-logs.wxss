.filters { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; padding: 8rpx; border-radius: 18rpx; background: #fff; }.filter { padding: 18rpx; border-radius: 14rpx; color: #806d6e; text-align: center; font-size: 25rpx; }.filter.active { background: #c03338; color: #fff; font-weight: 700; }.scope-tip { display: block; margin: 15rpx 5rpx 24rpx; color: #806d6e; font-size: 22rpx; }.log-card { margin-bottom: 18rpx; padding: 26rpx; }.log-head { display: flex; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 1rpx solid #f2e7e7; font-size: 28rpx; font-weight: 700; }.result { padding: 5rpx 14rpx; border-radius: 20rpx; background: #e9f7f0; color: #25845b; font-size: 20rpx; }.result.FAILED { background: #fae8e9; color: #c03338; }.detail { display: flex; justify-content: space-between; margin-top: 17rpx; color: #806d6e; font-size: 22rpx; }.detail text:last-child { color: #352526; }.empty { padding-top: 180rpx; color: #806d6e; text-align: center; font-size: 27rpx; }
.query-card { margin: 18rpx 0 24rpx; padding: 24rpx; }.query-label { display: block; margin: 17rpx 0 8rpx; color: #806d6e; font-size: 21rpx; }.query-label:first-child { margin-top: 0; }.query-field { display: flex; align-items: center; justify-content: space-between; min-height: 70rpx; padding: 0 17rpx; border: 2rpx solid #eddfe0; border-radius: 12rpx; background: #fffafa; box-sizing: border-box; font-size: 23rpx; }.query-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.query-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 22rpx; }.query-actions button { width: 100%; background: #f1eeee; color: #806d6e; font-size: 23rpx; }.query-actions .search-button { background: #c03338; color: #fff; }
.picker-label { min-width: 0; overflow: hidden; color: #352526; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.picker-arrow { color: #c03338; font-size: 30rpx; }
.action-selector-mask { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(35,22,23,.48); }
.action-selector-sheet { box-sizing: border-box; width: 100%; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; }
.action-selector-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; font-size: 31rpx; font-weight: 700; }
.selector-close { padding: 8rpx 0 8rpx 24rpx; color: #c03338; font-size: 25rpx; font-weight: 500; }
.action-search { box-sizing: border-box; width: 100%; height: 76rpx; padding: 0 22rpx; border: 2rpx solid #eddfe0; border-radius: 14rpx; background: #fffafa; font-size: 25rpx; }
.action-option-list { height: 620rpx; margin-top: 18rpx; }
.action-option { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; padding: 0 20rpx; border-bottom: 1rpx solid #f2e7e7; color: #352526; font-size: 26rpx; }
.action-option.selected { background: #fff4f4; color: #c03338; font-weight: 700; }
.selected-mark { color: #c03338; font-size: 30rpx; }
.no-action-option { padding: 90rpx 20rpx; color: #a08d8e; text-align: center; font-size: 25rpx; }
