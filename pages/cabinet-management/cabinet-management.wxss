.list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }.title { display: block; font-size: 40rpx; font-weight: 800; }.subtitle { display: block; margin-top: 7rpx; color: #806d6e; font-size: 22rpx; }.add-button { width: 190rpx; margin: 0; background: #c03338; color: #fff; font-size: 25rpx; }.cabinet-card { margin-bottom: 22rpx; padding: 28rpx; }.card-head { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid #f2e7e7; }.cabinet-id { display: block; font-size: 31rpx; font-weight: 800; }.cabinet-name { display: block; margin-top: 6rpx; color: #806d6e; font-size: 23rpx; }.status { padding: 7rpx 15rpx; border-radius: 22rpx; background: #e9f7f0; color: #25845b; font-size: 21rpx; }.status.MAINTENANCE { background: #fff1dc; color: #b66d16; }.status.DISABLED { background: #f1eeee; color: #806d6e; }.detail { display: flex; justify-content: space-between; margin-top: 18rpx; color: #806d6e; font-size: 24rpx; }.detail text:last-child { color: #352526; }.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 24rpx; }.actions button { width: 100%; background: #fae8e9; color: #c03338; font-size: 24rpx; }.empty { padding-top: 180rpx; color: #806d6e; text-align: center; }
.overview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-bottom: 20rpx; }.overview-grid view { padding: 20rpx 8rpx; border-radius: 16rpx; background: #fff; text-align: center; }.overview-grid text:first-child { display: block; color: #c03338; font-size: 32rpx; font-weight: 800; }.overview-grid text:last-child { color: #806d6e; font-size: 21rpx; }
.status-explanation { margin-bottom: 18rpx; padding: 16rpx 18rpx; border-radius: 13rpx; background: #fffafa; color: #806d6e; font-size: 20rpx; line-height: 1.6; }
.filters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 22rpx; padding: 7rpx; border-radius: 16rpx; background: #fff; }.filter { padding: 15rpx 8rpx; border-radius: 12rpx; color: #806d6e; text-align: center; font-size: 23rpx; }.filter.active { background: #c03338; color: #fff; font-weight: 700; }
.cabinet-card.needs-attention { border: 2rpx solid #e2a43c; }.alert-line { margin-top: 18rpx; padding: 13rpx 16rpx; border-radius: 12rpx; background: #fff1dc; color: #9a6218; font-size: 21rpx; }.filter-empty { padding: 100rpx 0; color: #806d6e; text-align: center; }
.actions button.restore { background: #e9f7f0; color: #25845b; }
.device-status-line { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: #fff1dc; color: #9a6218; font-size: 21rpx; }.device-status-line.connected { background: #e9f7f0; color: #25845b; }.device-status-line.disconnected { background: #fff1dc; color: #9a6218; }
