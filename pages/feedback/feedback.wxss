.header { padding: 30rpx 5rpx; }.title { display: block; font-size: 42rpx; font-weight: 800; }.subtitle { display: block; margin-top: 10rpx; color: #806d6e; font-size: 24rpx; }.form-card { padding: 30rpx; }.field-label { display: block; margin: 25rpx 0 12rpx; color: #806d6e; font-size: 24rpx; }.field-label:first-child { margin-top: 0; }.field { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; padding: 0 22rpx; border: 2rpx solid #eddfe0; border-radius: 15rpx; background: #fffafa; box-sizing: border-box; font-size: 27rpx; }.placeholder { color: #ad9c9d; }.picker-field text { color: #c03338; font-size: 38rpx; }.record-context { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; padding: 20rpx; border-radius: 14rpx; background: #fbf6f6; color: #806d6e; font-size: 23rpx; }.record-context text:last-child { max-width: 400rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #352526; }.description-field { width: 100%; min-height: 230rpx; padding: 22rpx; border: 2rpx solid #eddfe0; border-radius: 15rpx; background: #fffafa; box-sizing: border-box; font-size: 27rpx; line-height: 1.6; }.counter { display: block; margin-top: 8rpx; color: #ad9c9d; text-align: right; font-size: 21rpx; }.submit-button { margin-top: 30rpx; }.privacy-tip { display: block; margin-top: 20rpx; color: #a18f90; text-align: center; font-size: 21rpx; }
