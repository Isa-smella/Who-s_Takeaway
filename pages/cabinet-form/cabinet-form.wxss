.page-head { padding: 18rpx 4rpx 28rpx; }.page-head text:first-child { display: block; font-size: 40rpx; font-weight: 800; }.page-head text:last-child { display: block; margin-top: 8rpx; color: #806d6e; font-size: 23rpx; }.form-card { padding: 30rpx; }.label { display: block; margin: 25rpx 0 11rpx; color: #806d6e; font-size: 24rpx; }.label:first-child { margin-top: 0; }.field { width: 100%; min-height: 82rpx; padding: 0 20rpx; border: 2rpx solid #eddfe0; border-radius: 14rpx; background: #fffafa; box-sizing: border-box; font-size: 27rpx; }.field.disabled { background: #f3eeee; color: #806d6e; }.hint { display: block; margin-top: 9rpx; color: #a08d8e; font-size: 20rpx; }.notes { width: 100%; min-height: 180rpx; padding: 20rpx; border: 2rpx solid #eddfe0; border-radius: 14rpx; background: #fffafa; box-sizing: border-box; font-size: 27rpx; }.submit { margin-top: 28rpx; }
