.announcement-page { padding-bottom: 60rpx; }.page-head { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 4rpx 28rpx; }.page-head > view { flex: 1; min-width: 0; margin-right: 24rpx; }.page-title { display: block; font-size: 40rpx; font-weight: 800; }.page-subtitle { display: block; margin-top: 8rpx; color: #806d6e; font-size: 21rpx; line-height: 1.5; }.add-button { display: flex; flex: 0 0 180rpx; align-items: center; justify-content: center; width: 180rpx; min-width: 0; height: 80rpx; margin: 0; padding: 0 16rpx; box-sizing: border-box; border-radius: 16rpx; font-size: 25rpx; font-weight: 700; line-height: 1; white-space: nowrap; }
.empty-tip { padding: 180rpx 0; color: #806d6e; text-align: center; }.empty-card { padding: 90rpx 30rpx; text-align: center; }.empty-card text:first-child { display: block; font-size: 30rpx; font-weight: 700; }.empty-card text:last-child { display: block; margin-top: 12rpx; color: #806d6e; font-size: 23rpx; }
.announcement-card { margin-bottom: 20rpx; padding: 28rpx; }.item-head { display: flex; align-items: center; justify-content: space-between; }.item-head > view { display: flex; gap: 10rpx; }.type-badge,.status-badge { padding: 6rpx 14rpx; border-radius: 999rpx; font-size: 20rpx; }.type-badge { background: #fae8e9; color: #c03338; }.type-badge.ADVERTISEMENT { background: #fff0d7; color: #a86200; }.type-badge.MAINTENANCE { background: #edf3fb; color: #297ddf; }.status-badge { background: #f1eeee; color: #806d6e; }.status-badge.PUBLISHED { background: #e7f5ed; color: #25845b; }.priority { color: #a18f90; font-size: 20rpx; }.item-title { display: block; margin-top: 18rpx; font-size: 30rpx; font-weight: 750; }.item-summary { display: block; margin-top: 9rpx; color: #806d6e; font-size: 23rpx; line-height: 1.5; }.time-row { display: flex; flex-direction: column; gap: 5rpx; margin-top: 18rpx; color: #a08d8e; font-size: 20rpx; }.item-actions { display: flex; gap: 12rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #f2e7e7; }.action-button { display: flex; flex: 1 1 0%; align-items: center; justify-content: center; width: 0; min-width: 0; height: 76rpx; margin: 0; padding: 0 12rpx; box-sizing: border-box; border-radius: 14rpx; background: #fae8e9; color: #c03338; font-size: 24rpx; font-weight: 600; line-height: 1; white-space: nowrap; }.status-action { background: #edf3fb; color: #297ddf; }.delete-action { border: 2rpx solid #e9bfc1; background: #fff; color: #c03338; }
