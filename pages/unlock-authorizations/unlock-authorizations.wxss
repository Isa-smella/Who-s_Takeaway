.notice { margin-bottom: 22rpx; padding: 22rpx; border-radius: 16rpx; background: #edf3fb; color: #276aa9; font-size: 23rpx; line-height: 1.65; }.empty { padding: 48rpx 24rpx; color: #806d6e; text-align: center; }.authorization-card { margin-bottom: 20rpx; padding: 28rpx; }.title-row { display: flex; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid #f2e7e7; }.title-row text:first-child { font-size: 30rpx; font-weight: 800; }.title-row text:last-child { color: #297ddf; font-size: 21rpx; }.meta { display: flex; justify-content: space-between; margin-top: 18rpx; color: #806d6e; font-size: 22rpx; }.meta text:last-child { max-width: 430rpx; color: #352526; text-align: right; word-break: break-all; }.meta .countdown { color: #c03338; font-size: 27rpx; font-weight: 800; font-variant-numeric: tabular-nums; }.meta .matched { color: #297ddf; }.meta .mismatched { color: #c03338; }.authorization-card button { margin-top: 24rpx; }.authorization-card .scan-target { background: #c03338; color: #fff; }
.authorization-card .abandon-auth { margin-top: 10rpx; background: #fff; color: #806d6e; border: 1rpx solid #ddd0d1; font-size: 22rpx; }
