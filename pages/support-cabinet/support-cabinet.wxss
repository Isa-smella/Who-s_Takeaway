.device-status { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; padding: 22rpx; }.device-status-title { display: block; font-size: 27rpx; font-weight: 750; }.device-status-time { display: block; margin-top: 6rpx; color: #806d6e; font-size: 21rpx; }.ble-status { font-size: 27rpx; font-weight: 750; }.ble-status.connected { color: #25845b; }.ble-status.disconnected { color: #806d6e; }
.heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 20rpx; }.title { display: block; font-size: 34rpx; font-weight: 750; }.subtitle { display: block; margin-top: 6rpx; color: #806d6e; font-size: 22rpx; }.cloud-badge { padding: 8rpx 14rpx; border-radius: 20rpx; background: #e9f7f0; color: #25845b; font-size: 20rpx; }.architecture-tip { margin-bottom: 20rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #fff; color: #806d6e; font-size: 22rpx; line-height: 1.6; }.cabinet-warning { margin-bottom: 20rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #fff1dc; color: #8a5717; font-size: 22rpx; line-height: 1.5; }.hint { margin: 6rpx 0 16rpx; color: #806d6e; font-size: 22rpx; }.locker-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }.locker { position: relative; min-height: 190rpx; padding: 20rpx 16rpx; border-radius: 20rpx; color: #fff; box-sizing: border-box; overflow: hidden; }.locker.EMPTY { background: #29916f; }.locker.OCCUPIED { background: #de8d28; }.locker.MAINTENANCE, .locker.DISABLED { background: #747d7b; }.locker.selected { box-shadow: 0 0 0 5rpx #c03338, 0 8rpx 22rpx rgba(192, 51, 56, .22); }.number { display: block; font-size: 40rpx; font-weight: 800; }.status { display: block; margin-top: 3rpx; font-size: 25rpx; }.pickup-code { display: block; margin-top: 12rpx; font-size: 20rpx; }.door { position: absolute; left: 14rpx; bottom: 14rpx; padding: 5rpx 9rpx; border-radius: 9rpx; background: rgba(0, 0, 0, .18); font-size: 18rpx; }.door.OPEN { background: #9f3042; }.onsite { position: absolute; right: 12rpx; bottom: 14rpx; font-size: 18rpx; }.verify-panel { margin-top: 22rpx; padding: 24rpx; }.panel-title { display: block; margin-bottom: 20rpx; font-size: 28rpx; font-weight: 750; }.official-code { display: flex; justify-content: space-between; margin-bottom: 18rpx; color: #806d6e; font-size: 23rpx; }.official-code text:last-child { color: #c03338; font-size: 32rpx; font-weight: 800; letter-spacing: 3rpx; }.label { display: block; margin: 16rpx 0 8rpx; color: #806d6e; font-size: 22rpx; }.verify-panel input, .verify-panel textarea { width: 100%; padding: 16rpx; border: 1rpx solid #eadada; border-radius: 12rpx; box-sizing: border-box; background: #fff; }.verify-button, .unlock-button { margin-top: 18rpx; background: #fae8e9; color: #c03338; font-size: 23rpx; }.unlock-button { background: #c03338; color: #fff; }.verified-tip, .authorization-result, .audit-tip, .prefill-tip { display: block; margin-top: 14rpx; color: #25845b; font-size: 21rpx; line-height: 1.5; }.authorization-result { color: #c03338; }.audit-tip, .prefill-tip { color: #806d6e; }
