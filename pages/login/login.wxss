.auth-page { text-align: center; }.login-brand { position: relative; height: 230rpx; margin-top: 34rpx; overflow: hidden; border-radius: 26rpx; isolation: isolate; }.login-brand-background { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; opacity: .2; pointer-events: none; }.logo { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; height: 100%; color: #c03338; font-size: 48rpx; font-weight: 800; text-shadow: 0 2rpx 9rpx rgba(255,255,255,.95); }.title { display: block; margin-top: 30rpx; font-size: 40rpx; font-weight: 750; }.description { display: block; margin: 18rpx auto 40rpx; color: #806d6e; font-size: 26rpx; line-height: 1.7; }.form-card { padding: 34rpx; text-align: left; }.label { color: #806d6e; font-size: 24rpx; }.role-picker { margin-top: 16rpx; padding: 25rpx; border-radius: 16rpx; background: #fbf6f6; }.login-button { margin-top: 30rpx; }.tip { display: block; margin-top: 30rpx; color: #a18f90; font-size: 22rpx; }
