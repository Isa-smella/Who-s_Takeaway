.overview, .inspection-card { padding: 28rpx; }.head { display: flex; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid #f2e7e7; }.head view text:first-child { display: block; font-size: 32rpx; font-weight: 800; }.head view text:last-child { display: block; margin-top: 5rpx; color: #806d6e; font-size: 22rpx; }.status { align-self: flex-start; padding: 6rpx 13rpx; border-radius: 18rpx; background: #fff1dc; color: #b66d16; font-size: 19rpx; }.status.RESOLVED { background: #e9f7f0; color: #25845b; }.row { display: flex; justify-content: space-between; margin-top: 17rpx; color: #806d6e; font-size: 22rpx; }.row text:last-child { max-width: 430rpx; color: #352526; text-align: right; }.record-id { word-break: break-all; }.action { margin-top: 20rpx; }.emergency { background: #c03338; color: #fff; }.handover-status { margin-top: 20rpx; padding: 18rpx; border-radius: 14rpx; background: #fff1dc; color: #9a6218; text-align: center; font-size: 21rpx; }.handover-status.completed { background: #e9f7f0; color: #25845b; }.inspection-card { margin-top: 22rpx; }.section-title { display: block; margin-bottom: 12rpx; font-size: 28rpx; font-weight: 800; }.inspection-row { display: flex; justify-content: space-between; padding: 19rpx 0; border-bottom: 1rpx solid #f2e7e7; color: #806d6e; font-size: 23rpx; }.inspection-row picker { color: #352526; }.inspection-card textarea { box-sizing: border-box; width: 100%; height: 130rpx; margin-top: 20rpx; padding: 16rpx; border: 1rpx solid #eadcdd; border-radius: 12rpx; background: #fffafa; font-size: 22rpx; }.save-inspection { margin-top: 16rpx; background: #edf3fb; color: #297ddf; font-size: 23rpx; }.notes { display: block; margin-top: 18rpx; color: #806d6e; font-size: 22rpx; }.self-check { margin-top: 22rpx; padding: 20rpx; border-radius: 15rpx; background: #fff1dc; color: #9a6218; font-size: 22rpx; }.self-check.passed { background: #e9f7f0; color: #25845b; }.restore-hint { display: block; margin: 20rpx 20rpx 0; color: #9a6218; text-align: center; font-size: 21rpx; }.restore { background: #25845b; color: #fff; }.restore[disabled] { background: #d7cfce; color: #fff; }.resolved { margin-top: 24rpx; padding: 24rpx; border-radius: 16rpx; background: #e9f7f0; color: #25845b; text-align: center; font-size: 23rpx; }
.self-check-action { margin-top: 16rpx; background: #c03338; color: #fff; font-size: 23rpx; }
