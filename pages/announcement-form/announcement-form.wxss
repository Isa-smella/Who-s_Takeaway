.form-page { padding-bottom: 60rpx; }.page-head { padding: 18rpx 4rpx 28rpx; }.page-head text:first-child { display: block; font-size: 40rpx; font-weight: 800; }.page-head text:last-child { display: block; margin-top: 8rpx; color: #806d6e; font-size: 22rpx; }.form-card { padding: 30rpx; }.label { display: block; margin: 27rpx 0 11rpx; color: #806d6e; font-size: 24rpx; }.label:first-child { margin-top: 0; }.field,.picker-field { width: 100%; min-height: 82rpx; padding: 0 20rpx; border: 2rpx solid #eddfe0; border-radius: 14rpx; background: #fffafa; box-sizing: border-box; font-size: 26rpx; }.field { height: 82rpx; }.picker-field { display: flex; align-items: center; justify-content: space-between; }.summary,.content { width: 100%; padding: 20rpx; border: 2rpx solid #eddfe0; border-radius: 14rpx; background: #fffafa; box-sizing: border-box; font-size: 26rpx; }.summary { min-height: 135rpx; }.content { min-height: 230rpx; }.hint { display: block; margin-top: 9rpx; color: #a08d8e; font-size: 20rpx; line-height: 1.5; }.image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }.image-tile { position: relative; overflow: hidden; min-width: 0; aspect-ratio: 1; border-radius: 14rpx; background: #f5eeee; }.image-preview { display: block; width: 100%; height: 100%; }.cover-label { position: absolute; left: 8rpx; bottom: 8rpx; padding: 4rpx 9rpx; border-radius: 999rpx; background: rgba(192,51,56,.9); color: #fff; font-size: 17rpx; }.remove-image { position: absolute; top: 6rpx; right: 6rpx; width: 42rpx; height: 42rpx; margin: 0; padding: 0; border-radius: 50%; background: rgba(35,25,26,.72); color: #fff; font-size: 30rpx; line-height: 38rpx; }.remove-image::after,.add-image-button::after { border: 0; }.add-image-button { width: 100%; margin: 14rpx 0 0; border: 2rpx dashed #e5bfc1; border-radius: 14rpx; background: #fce8e9; color: #c03338; font-size: 24rpx; line-height: 72rpx; }.switch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding-top: 25rpx; border-top: 1rpx solid #f2e7e7; }.switch-row view text:first-child { display: block; font-size: 26rpx; font-weight: 700; }.switch-row view text:last-child { display: block; margin-top: 6rpx; color: #a08d8e; font-size: 20rpx; }.date-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 16rpx; }.date-grid .picker-field { justify-content: center; }.submit { margin-top: 28rpx; }
