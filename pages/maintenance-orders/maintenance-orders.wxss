.summary { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.summary view { padding: 22rpx; border-radius: 17rpx; background: #fff; text-align: center; }.summary text:first-child { display: block; color: #c03338; font-size: 36rpx; font-weight: 800; }.summary text:last-child { color: #806d6e; font-size: 21rpx; }.filters { display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; margin: 20rpx 0; padding: 6rpx; border-radius: 15rpx; background: #fff; }.filters view { padding: 15rpx; border-radius: 11rpx; color: #806d6e; text-align: center; font-size: 22rpx; }.filters .active { background: #c03338; color: #fff; font-weight: 700; }.empty { padding: 60rpx; color: #806d6e; text-align: center; }.empty text { display: block; line-height: 1.6; }.empty text:last-child { margin-top: 12rpx; font-size: 21rpx; }.order-card { margin-bottom: 18rpx; padding: 26rpx; }.order-head { display: flex; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 1rpx solid #f2e7e7; }.order-head view text:first-child { display: block; font-size: 29rpx; font-weight: 800; }.order-head view text:last-child { display: block; margin-top: 4rpx; color: #806d6e; font-size: 21rpx; }.status { align-self: flex-start; padding: 6rpx 13rpx; border-radius: 18rpx; background: #fff1dc; color: #b66d16; font-size: 19rpx; }.status.RESOLVED { background: #e9f7f0; color: #25845b; }.status.SELF_CHECK_PASSED { background: #edf3fb; color: #297ddf; }.detail { display: flex; justify-content: space-between; margin-top: 14rpx; color: #806d6e; font-size: 21rpx; }.detail text:last-child { max-width: 430rpx; color: #352526; text-align: right; }.view-link { display: block; margin-top: 18rpx; color: #c03338; text-align: right; font-size: 21rpx; font-weight: 700; }
