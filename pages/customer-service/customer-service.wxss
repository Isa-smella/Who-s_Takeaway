.header { padding: 35rpx 5rpx; }.title { display: block; font-size: 44rpx; font-weight: 800; }.subtitle { display: block; margin-top: 12rpx; color: #806d6e; font-size: 25rpx; }
.context-card { margin-bottom: 30rpx; padding: 25rpx 30rpx; }.context-title { display: block; margin-bottom: 12rpx; color: #c03338; font-size: 25rpx; font-weight: 700; }.context-card view { display: flex; justify-content: space-between; padding: 12rpx 0; color: #806d6e; font-size: 24rpx; }.context-card view text:last-child { color: #352526; }.record-id { max-width: 400rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.context-card view .missing-context { color: #c03338; }.scan-context-button { width: 100%; margin-top: 16rpx; background: #fae8e9; color: #c03338; font-size: 24rpx; }.missing-tip { display: block; margin-top: 12rpx; color: #9a7779; font-size: 20rpx; line-height: 1.55; }
.section-title { display: block; margin: 0 0 15rpx 8rpx; color: #806d6e; font-size: 24rpx; }.faq { padding: 0 30rpx; }.faq-item { padding: 28rpx 0; border-bottom: 1rpx solid #f2e7e7; }.faq-item:last-child { border-bottom: 0; }.question { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; font-weight: 650; }.arrow { color: #b49fa0; font-size: 40rpx; transform: rotate(0); }.arrow.open { transform: rotate(90deg); }.answer { display: block; padding: 22rpx 35rpx 0 0; color: #806d6e; font-size: 25rpx; line-height: 1.7; }.feedback-button { margin-top: 22rpx; background: #fff; color: #c03338; border: 2rpx solid #c03338; font-size: 26rpx; }
.wechat-service-button { box-sizing: border-box; width: 100%; margin-top: 32rpx; padding: 0 18rpx; background: #c03338; color: #fff; font-size: 26rpx; font-weight: 750; white-space: nowrap; }.service-tip { display: block; margin-top: 15rpx; color: #a18f90; text-align: center; font-size: 21rpx; line-height: 1.6; }
.service-tip + .section-title { margin-top: 34rpx; }
.authorization-ready { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 22rpx; background: #edf3fb; color: #297ddf; text-align: left; }.authorization-ready view text:first-child { display: block; font-size: 26rpx; font-weight: 800; }.authorization-ready view text:last-child { display: block; margin-top: 5rpx; color: #6a87a7; font-size: 21rpx; }.authorization-ready > text { font-size: 21rpx; font-weight: 700; }.authorization-ready + .section-title { margin-top: 34rpx; }
.cancel-request-button { margin-top: 14rpx; background: #fff; color: #806d6e; border: 1rpx solid #ddd0d1; font-size: 22rpx; }
.manual-context-form { display: block !important; margin-top: 18rpx; padding-top: 18rpx !important; border-top: 1rpx solid #f1e3e4; }.manual-title { display: block; margin-bottom: 12rpx; color: #352526; font-size: 22rpx; font-weight: 700; }.manual-context-form input { box-sizing: border-box; width: 100%; height: 72rpx; margin-top: 10rpx; padding: 0 18rpx; border: 1rpx solid #eadcdd; border-radius: 12rpx; background: #fffafa; font-size: 23rpx; }.manual-context-form button { width: 100%; margin-top: 14rpx; background: #fae8e9; color: #c03338; font-size: 23rpx; }
