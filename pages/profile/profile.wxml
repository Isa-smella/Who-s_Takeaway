<view class="page profile-page">
  <view class="profile-card">
    <view>
      <view class="name-entry" hover-class="name-entry-active" bindtap="showAccount"><text class="name">{{userName}}</text><text class="edit-name-tip">注册编号</text></view>
      <text class="role">{{roleLabel}}</text>
    </view>
  </view>

  <view class="stats card">
    <view class="stat-link" hover-class="stat-link-active" bindtap="goPickupRecords">
      <text class="number">{{pickupCount}}</text>
      <view class="stat-label-row"><text class="stat-label">取餐记录</text><text class="stat-arrow">›</text></view>
    </view>
    <view class="stat-link" hover-class="stat-link-active" bindtap="goDepositRecords">
      <text class="number">{{totalCount}}</text>
      <view class="stat-label-row"><text class="stat-label">累计存入（跨柜体）</text><text class="stat-arrow">›</text></view>
    </view>
  </view>

  <view class="menu card">
    <view wx:if="{{canManage}}" class="menu-item management-item" bindtap="goManagement"><text>管理中心</text><text class="arrow">›</text></view>
    <view wx:if="{{canHandleFeedback}}" class="menu-item management-item" bindtap="goFeedbackManagement"><text>客服处理中心</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goDepositRecords"><text>我的存入记录</text><text class="arrow">›</text></view>
    <view wx:if="{{unlockAuthorizationCount > 0}}" class="menu-item" bindtap="goUnlockAuthorizations"><text>客服开锁授权（{{unlockAuthorizationCount}}）</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goMyFeedback"><text>我的反馈</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="cooperationContact"><text>合作联系</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="contactService"><text>客服 / 帮助</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="showAccount"><text>账号信息</text><text class="arrow">›</text></view>
    <view class="menu-item legal-menu-item">
      <text>协议与隐私</text>
      <view class="legal-links"><text class="legal-link" bindtap="showAgreement">用户协议</text><text class="legal-separator">·</text><text class="legal-link" bindtap="showPrivacy">隐私政策</text></view>
    </view>
    <view class="menu-item logout-item" bindtap="logout"><text>退出登录</text><text class="arrow">›</text></view>
  </view>
  <view class="development-tip">当前为开发环境，微信身份与账号角色由云端数据库管理</view>
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goHome"><text class="nav-icon">⌂</text><text>首页</text></view>
    <view class="scan-nav-item" bindtap="scanCabinet">
      <view class="scan-button">
        <view class="scan-glyph">
          <view class="scan-corner top-left"></view><view class="scan-corner top-right"></view>
          <view class="scan-corner bottom-left"></view><view class="scan-corner bottom-right"></view>
          <view class="scan-line"></view>
        </view>
      </view>
      <text class="scan-label">扫一扫</text>
    </view>
    <view class="nav-item active"><text class="nav-icon">人</text><text>个人中心</text></view>
  </view>
</view>
