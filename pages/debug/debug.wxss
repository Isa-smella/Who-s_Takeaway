.notice { padding: 24rpx; margin-bottom: 24rpx; border-radius: 16rpx; background: #fff3d7; color: #765a1c; font-size: 25rpx; }
.section { padding: 28rpx; margin-bottom: 24rpx; }.section-title { display: block; margin-bottom: 22rpx; font-size: 31rpx; font-weight: 700; }
.cabinet-input { height: 82rpx; padding: 0 22rpx; border: 2rpx solid #ead9da; border-radius: 14rpx; background: #fffafa; font-size: 27rpx; }.switch-button { margin-top: 18rpx; font-size: 26rpx; }
.button-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.button-grid.three { grid-template-columns: repeat(3, 1fr); }
.button-grid button { width: 100%; padding: 0 8rpx; background: #fae8e9; color: #c03338; font-size: 24rpx; }
.picker { padding: 22rpx; background: #f3f6f5; border-radius: 14rpx; }.snapshot { padding: 20rpx 0; color: #516c66; }
.group-label { display: block; margin: 24rpx 0 12rpx; font-size: 23rpx; color: #758783; }.reset { background: #fff; color: #a24444; }
.health-button { margin-top: 14rpx; background: #edf3fb; color: #297ddf; font-size: 24rpx; }
