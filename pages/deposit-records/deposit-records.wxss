.record-filters { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-bottom: 25rpx; padding: 8rpx; border-radius: 18rpx; background: #fff; }
.cabinet-filter-tip { display: block; margin-bottom: 15rpx; color: #806d6e; font-size: 23rpx; }
.filter-item { padding: 18rpx 12rpx; border-radius: 14rpx; color: #806d6e; text-align: center; font-size: 26rpx; }
.filter-item.active { background: #c03338; color: #fff; font-weight: 700; }
.record { margin-bottom: 24rpx; padding: 30rpx; }
.record-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 24rpx; border-bottom: 1rpx solid #f2e7e7; }.locker-number { font-size: 35rpx; font-weight: 800; }
.cabinet-name { display: block; margin-bottom: 5rpx; color: #806d6e; font-size: 22rpx; }
.record-status { padding: 8rpx 18rpx; border-radius: 30rpx; font-size: 22rpx; }.record-status.WAITING_PICKUP { background: #fff1dc; color: #b66d16; }.record-status.PICKED_UP { background: #edf3fb; color: #297ddf; }.record-status.ADMIN_CLEARED { background: #f1eeee; color: #806d6e; }
.detail { display: flex; justify-content: space-between; margin-top: 22rpx; color: #806d6e; font-size: 26rpx; }.detail text:last-child { color: #352526; }.pickup-code { color: #c03338 !important; font-size: 31rpx; font-weight: 750; letter-spacing: 3rpx; }
.record-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.record-action { flex: 1; min-width: 0; margin: 0; font-size: 27rpx; }
.copy-button { background: #fae8e9; color: #c03338; }
.reopen-button { background: #c03338; color: #fff; }
.reopen-button[disabled] { background: #d8cfd0; color: #fff; }
.empty { display: flex; flex-direction: column; align-items: center; padding-top: 180rpx; text-align: center; }.empty-icon { display: flex; align-items: center; justify-content: center; width: 110rpx; height: 110rpx; border-radius: 50%; background: #fae8e9; color: #c03338; font-size: 36rpx; font-weight: 800; }.empty-title { margin: 30rpx 0 12rpx; font-size: 32rpx; font-weight: 700; }
