.home { min-height: 100vh; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); text-align: center; }
.brand-area { position: relative; min-height: 176rpx; overflow: hidden; isolation: isolate; }
.brand-background { position: absolute; z-index: 0; left: 0; top: 0; width: 100%; height: auto; opacity: .18; pointer-events: none; }
.brand { position: relative; z-index: 1; margin-top: 54rpx; font-size: 58rpx; font-weight: 800; color: #c03338; text-shadow: 0 2rpx 8rpx rgba(255,255,255,.9); }
.subtitle { position: relative; z-index: 1; margin: 12rpx 0 48rpx; color: #806d6e; text-shadow: 0 1rpx 6rpx rgba(255,255,255,.95); }
.cabinet-card { position: relative; min-height: 210rpx; padding: 38rpx; overflow: hidden; text-align: left; isolation: isolate; }
.cabinet-card-content { position: relative; z-index: 1; }
.label { display: block; font-size: 24rpx; color: #7d8d89; }
.cabinet-id { display: block; margin-top: 8rpx; font-size: 42rpx; font-weight: 700; }
.connection { display: flex; align-items: center; gap: 16rpx; margin-top: 30rpx; font-size: 30rpx; font-weight: 600; }
.no-cabinet { margin-top: 28rpx; padding: 22rpx; border-radius: 16rpx; background: rgba(250,232,233,.88); color: #8f2529; font-size: 25rpx; backdrop-filter: blur(2rpx); }
.connection.CONNECTED { color: #297ddf; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #999; }
.CONNECTED .dot { background: #297ddf; box-shadow: 0 0 0 8rpx rgba(41,125,223,.14); }
.CONNECTING .dot { background: #e9a52d; }.ERROR .dot,.DISCONNECTED .dot { background: #d65959; }
.failure { margin-top: 28rpx; padding-top: 26rpx; border-top: 1rpx solid #f2e7e7; color: #806d6e; font-size: 25rpx; }
.compact { margin-top: 20rpx; font-size: 27rpx; }
.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx; margin-top: 34rpx; }
.actions.single-action { grid-template-columns: 1fr; }
.action { height: 190rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.action-char { display: block; font-size: 55rpx; font-weight: 800; line-height: 1.1; }
.utility-actions { display: grid; grid-template-columns: 1fr 120rpx; gap: 16rpx; margin-top: 78rpx; }.utility-actions.customer-only { display: flex; justify-content: flex-end; }
.small-tool-button { display: flex; align-items: center; justify-content: center; height: 72rpx; margin: 0; border-radius: 18rpx; background: #fff; color: #8f2529; font-size: 24rpx; line-height: 1; box-sizing: border-box; }
.debug-entry { width: 100%; border: 2rpx dashed #e2b9bb; }.service-entry { position: relative; width: 120rpx; overflow: visible; border: 2rpx solid #f0d9da; }.service-entry > text { position: relative; z-index: 2; }.service-mascot { position: absolute; right: 8rpx; bottom: 56rpx; z-index: 3; width: 104rpx; pointer-events: none; }
.notice-board { margin-top: 28rpx; padding: 26rpx 28rpx 18rpx; text-align: left; }
.notice-board-header { display: flex; align-items: center; justify-content: space-between; }.notice-board-header > view { display: flex; align-items: center; gap: 12rpx; }.notice-board-mark { width: 8rpx; height: 30rpx; border-radius: 8rpx; background: #c03338; }.notice-board-title { font-size: 30rpx; font-weight: 750; }.notice-board-count { color: #a18f90; font-size: 21rpx; }
.notice-swiper { height: 190rpx; margin-top: 14rpx; }.notice-item { display: flex; gap: 20rpx; height: 166rpx; padding: 18rpx; border-radius: 18rpx; background: #fff8f8; box-sizing: border-box; }.notice-media { position: relative; flex: none; width: 180rpx; height: 130rpx; }.notice-image { display: block; width: 100%; height: 100%; border-radius: 14rpx; background: #f4e8e8; }.notice-image-count { position: absolute; right: 7rpx; bottom: 7rpx; padding: 4rpx 9rpx; border-radius: 999rpx; background: rgba(35,25,26,.72); color: #fff; font-size: 17rpx; }.notice-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: flex-start; }.notice-type { padding: 5rpx 13rpx; border-radius: 999rpx; background: #fae8e9; color: #c03338; font-size: 19rpx; line-height: 1.2; }.notice-type.ADVERTISEMENT { background: #fff0d7; color: #b16a00; }.notice-type.MAINTENANCE { background: #edf3fb; color: #297ddf; }.notice-title { display: block; width: 100%; margin-top: 9rpx; overflow: hidden; font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.notice-summary { display: -webkit-box; width: 100%; margin-top: 6rpx; overflow: hidden; color: #806d6e; font-size: 21rpx; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.notice-more { margin-top: auto; color: #c03338; font-size: 20rpx; }
.staff-role-tip { margin-top: 34rpx; padding: 24rpx; border-radius: 18rpx; background: #fff; color: #806d6e; font-size: 24rpx; line-height: 1.6; }
.authorization-banner { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 24rpx; border-radius: 18rpx; background: #edf3fb; color: #297ddf; text-align: left; }.authorization-banner view text:first-child { display: block; font-size: 26rpx; font-weight: 750; }.authorization-banner view text:last-child { display: block; margin-top: 6rpx; color: #6a87a7; font-size: 20rpx; }.authorization-banner > text { font-size: 22rpx; font-weight: 700; }
