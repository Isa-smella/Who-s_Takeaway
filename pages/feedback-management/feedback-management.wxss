.summary { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-bottom: 20rpx; }.summary view { padding: 22rpx; border-radius: 18rpx; background: #fff; text-align: center; }.summary text:first-child { display: block; color: #c03338; font-size: 35rpx; font-weight: 800; }.summary text:last-child { color: #806d6e; font-size: 22rpx; }.filters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 24rpx; padding: 7rpx; border-radius: 16rpx; background: #fff; }.filter { padding: 16rpx 8rpx; border-radius: 12rpx; color: #806d6e; text-align: center; font-size: 23rpx; }.filter.active { background: #c03338; color: #fff; font-weight: 700; }.feedback-card { margin-bottom: 22rpx; padding: 28rpx; }.card-head { display: flex; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid #f2e7e7; }.problem { display: block; font-size: 29rpx; font-weight: 750; }.created-time { display: block; margin-top: 6rpx; color: #806d6e; font-size: 21rpx; }.status { align-self: flex-start; padding: 7rpx 15rpx; border-radius: 22rpx; background: #fff1dc; color: #b66d16; font-size: 20rpx; }.status.PROCESSING { background: #edf3fb; color: #297ddf; }.status.RESOLVED { background: #e9f7f0; color: #25845b; }.detail { display: flex; justify-content: space-between; margin-top: 18rpx; color: #806d6e; font-size: 23rpx; }.detail text:last-child { max-width: 430rpx; color: #352526; text-align: right; }.description { margin-top: 20rpx; padding: 18rpx; border-radius: 13rpx; background: #fffafa; font-size: 23rpx; line-height: 1.6; }.description text:first-child { display: block; margin-bottom: 6rpx; color: #806d6e; font-size: 20rpx; }.process-button, .resolve-button { margin-top: 22rpx; font-size: 24rpx; }.process-button { background: #fae8e9; color: #c03338; }.resolve-button { background: #e9f7f0; color: #25845b; }.empty { padding-top: 160rpx; color: #806d6e; text-align: center; }
.trace-button { margin-top: 22rpx; background: #edf3fb; color: #297ddf; font-size: 24rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 16rpx; color: #806d6e; font-size: 20rpx; }.section-title { color: #352526; font-size: 32rpx; font-weight: 800; }.cabinet-list { margin-bottom: 32rpx; }.support-cabinet-card { display: grid; grid-template-columns: 1fr auto; gap: 12rpx 20rpx; margin-bottom: 16rpx; padding: 24rpx; }.support-cabinet-id { display: block; font-size: 28rpx; font-weight: 800; }.support-cabinet-name { display: block; margin-top: 5rpx; color: #806d6e; font-size: 21rpx; }.support-cabinet-meta { text-align: right; color: #806d6e; font-size: 20rpx; }.support-cabinet-meta text { display: block; }.cabinet-status { color: #25845b; font-weight: 700; }.cabinet-status.MAINTENANCE { color: #b66d16; }.cabinet-status.DISABLED { color: #806d6e; }.support-cabinet-card button { grid-column: 1 / 3; width: 100%; margin-top: 6rpx; background: #fae8e9; color: #c03338; font-size: 23rpx; }.support-cabinet-card button[disabled] { background: #f1eeee; color: #a39797; }.feedback-head { margin-top: 10rpx; }
.cabinet-search { display: flex; align-items: center; margin-bottom: 18rpx; padding: 0 20rpx; border-radius: 15rpx; background: #fff; }.cabinet-search input { flex: 1; height: 78rpx; font-size: 23rpx; }.cabinet-search text { padding-left: 18rpx; color: #c03338; font-size: 22rpx; }.cabinet-empty { padding: 60rpx 0; color: #806d6e; text-align: center; font-size: 23rpx; }
.support-filters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-bottom: 16rpx; padding: 6rpx; border-radius: 15rpx; background: #fff; }.support-filters view { padding: 14rpx; border-radius: 11rpx; color: #806d6e; text-align: center; font-size: 21rpx; }.support-filters .active { background: #c03338; color: #fff; font-weight: 700; }.support-empty { margin-bottom: 28rpx; padding: 30rpx; border-radius: 16rpx; background: #fff; color: #806d6e; text-align: center; font-size: 22rpx; }.support-request-card { margin-bottom: 16rpx; padding: 24rpx; border-left: 7rpx solid #c03338; }.request-head, .request-user { display: flex; justify-content: space-between; }.request-head text:first-child { font-size: 27rpx; font-weight: 800; }.request-status { padding: 5rpx 12rpx; border-radius: 16rpx; background: #fff1dc; color: #b66d16; font-size: 19rpx; }.request-status.AUTHORIZED { background: #edf3fb; color: #297ddf; }.request-status.REQUIRES_ONSITE_MAINTENANCE { background: #fae8e9; color: #c03338; }.request-status.RESOLVED { background: #e9f7f0; color: #25845b; }.request-user { margin-top: 12rpx; color: #806d6e; font-size: 20rpx; }.request-user text:last-child { color: #352526; }.support-request-card button { margin-top: 18rpx; background: #c03338; color: #fff; font-size: 23rpx; }.support-request-card button[disabled] { background: #f1eeee; color: #a39797; }.support-request-card .revoke-auth { background: #fff1dc; color: #9a6218; }.support-request-card .close-request { margin-top: 10rpx; background: #fff; color: #806d6e; border: 1rpx solid #ddd0d1; }.onsite-tip { display: block; margin-top: 16rpx; color: #c03338; font-size: 21rpx; }
.support-request-card .bind-context { background: #edf3fb; color: #297ddf; }.bind-context-form { margin-top: 14rpx; padding: 16rpx; border-radius: 13rpx; background: #f8f5f5; }.bind-context-form picker { margin-bottom: 10rpx; padding: 16rpx; border-radius: 10rpx; background: #fff; color: #352526; font-size: 22rpx; }.bind-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }.support-request-card .bind-actions button { margin-top: 0; background: #fff; color: #806d6e; border: 1rpx solid #ddd0d1; }.support-request-card .bind-actions button:last-child { background: #c03338; color: #fff; border-color: #c03338; }
.trace-user-head { margin-top: 10rpx; }.trace-user-card { display: grid; gap: 12rpx; margin-bottom: 28rpx; padding: 22rpx; }.trace-user-card input { height: 76rpx; padding: 0 18rpx; border-radius: 12rpx; background: #fffafa; font-size: 23rpx; }.trace-user-card button { margin: 4rpx 0 0; background: #edf3fb; color: #297ddf; font-size: 24rpx; }
